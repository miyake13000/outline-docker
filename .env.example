# Copy to .env and edit before starting.
OUTLINE_VERSION=1.12.0
# URL accessed by your browser (also used in authentication callbacks).
OUTLINE_URL=http://localhost:3000
OUTLINE_BIND_ADDRESS=127.0.0.1
OUTLINE_PORT=3000

# Generate EACH value separately with: openssl rand -hex 32
# Use hexadecimal for POSTGRES_PASSWORD so DATABASE_URL needs no URL escaping.
POSTGRES_PASSWORD=
SECRET_KEY=
UTILS_SECRET=

DEFAULT_LANGUAGE=ja_JP
WEB_CONCURRENCY=1
LOG_LEVEL=info
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Local Dex. Manage users with python3 scripts/dex-users.py.
DEX_VERSION=v2.46.1
DEX_URL=http://localhost:5556
DEX_PORT=5556
OIDC_CLIENT_SECRET=

# Optional mail delivery. Configure according to your SMTP provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=Outline <outline@example.com>
